{
  "name": "warden",
  "displayName": "Warden Workspace Review",
  "description": "Plan parallel workspaces, review with native diffs, and run an isolated live preview.",
  "version": "0.20.4",
  "publisher": "xbghc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xbghc/warden.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Warden runs Git, commit hooks and explicitly configured setup scripts."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Warden needs a local or remote filesystem and Git."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "warden",
          "title": "Warden",
          "icon": "media/warden.svg"
        }
      ]
    },
    "views": {
      "warden": [
        {
          "id": "warden.task",
          "name": "工作区",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "warden.selectRepository",
        "title": "选择仓库",
        "category": "Warden"
      },
      {
        "command": "warden.refresh",
        "title": "刷新",
        "category": "Warden",
        "icon": "$(refresh)"
      },
      {
        "command": "warden.configure",
        "title": "选择主开发分支",
        "category": "Warden"
      },
      {
        "command": "warden.createTask",
        "title": "新增任务",
        "category": "Warden",
        "icon": "$(add)"
      },
      {
        "command": "warden.taskActions",
        "title": "任务操作",
        "category": "Warden",
        "icon": "$(ellipsis)"
      },
      {
        "command": "warden.startTask",
        "title": "创建工作区",
        "category": "Warden",
        "icon": "$(add)"
      },
      {
        "command": "warden.editTask",
        "title": "编辑任务",
        "category": "Warden",
        "icon": "$(edit)"
      },
      {
        "command": "warden.moveTask",
        "title": "调整计划顺序",
        "category": "Warden"
      },
      {
        "command": "warden.connect",
        "title": "连接／断开预览",
        "category": "Warden",
        "icon": "$(plug)"
      },
      {
        "command": "warden.openDiff",
        "title": "打开原生差异",
        "category": "Warden"
      },
      {
        "command": "warden.deliver",
        "title": "交付提交",
        "category": "Warden"
      },
      {
        "command": "warden.retryHook",
        "title": "重试工作区脚本",
        "category": "Warden"
      },
      {
        "command": "warden.resumeTask",
        "title": "结束已恢复的提交准备",
        "category": "Warden"
      },
      {
        "command": "warden.previewTerminal",
        "title": "打开预览终端",
        "category": "Warden"
      },
      {
        "command": "warden.runPreview",
        "title": "运行预览",
        "category": "Warden"
      },
      {
        "command": "warden.previewPath",
        "title": "复制预览路径",
        "category": "Warden"
      },
      {
        "command": "warden.refreshPreview",
        "title": "立即同步预览",
        "category": "Warden"
      },
      {
        "command": "warden.setup",
        "title": "重跑预览 setup",
        "category": "Warden"
      },
      {
        "command": "warden.configureScripts",
        "title": "编辑脚本配置",
        "category": "Warden"
      },
      {
        "command": "warden.rebase",
        "title": "同步工作区",
        "category": "Warden",
        "icon": "$(sync)"
      },
      {
        "command": "warden.editHistory",
        "title": "编辑提交历史",
        "category": "Warden"
      },
      {
        "command": "warden.copyWorkspace",
        "title": "复制工作区路径",
        "category": "Warden"
      },
      {
        "command": "warden.importNotes",
        "title": "导入旧笔记",
        "category": "Warden"
      },
      {
        "command": "warden.selectTask",
        "title": "查看任务变更",
        "category": "Warden"
      },
      {
        "command": "warden.showPreview",
        "title": "查看预览",
        "category": "Warden"
      },
      {
        "command": "warden.copyLocation",
        "title": "复制审阅位置",
        "category": "Warden"
      },
      {
        "command": "warden.chat",
        "title": "Chat with Agent",
        "category": "Warden"
      },
      {
        "command": "warden.configureAgents",
        "title": "Configure ACP Agent",
        "category": "Warden"
      },
      {
        "command": "warden.sendSelectionToAgent",
        "title": "Add Selection to Task Chat",
        "category": "Warden"
      },
      {
        "command": "warden.openWorkspace",
        "title": "打开工作区",
        "category": "Warden",
        "icon": "$(folder-opened)"
      },
      {
        "command": "warden.syncTask",
        "title": "需要同步",
        "category": "Warden",
        "icon": "$(sync)"
      },
      {
        "command": "warden.syncConflict",
        "title": "同步冲突：查看详情",
        "category": "Warden",
        "icon": "$(warning)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "warden.refresh",
          "when": "view == warden.task && warden.hasDevelopmentBranch",
          "group": "navigation@1"
        },
        {
          "command": "warden.createTask",
          "when": "view == warden.task && warden.hasDevelopmentBranch",
          "group": "navigation@2"
        },
        {
          "command": "warden.configure",
          "when": "view == warden.task && warden.hasDevelopmentBranch"
        },
        {
          "command": "warden.selectRepository",
          "when": "view == warden.task && (warden.multipleRoots || !warden.hasRepository)"
        },
        {
          "command": "warden.configureScripts",
          "when": "view == warden.task && warden.hasDevelopmentBranch"
        },
        {
          "command": "warden.rebase",
          "when": "view == warden.task && warden.hasDevelopmentBranch",
          "group": "navigation@3"
        },
        {
          "command": "warden.editHistory",
          "when": "view == warden.task && warden.hasDevelopmentBranch"
        }
      ],
      "commandPalette": [
        {
          "command": "warden.openDiff",
          "when": "false"
        },
        {
          "command": "warden.syncTask",
          "when": "false"
        },
        {
          "command": "warden.syncConflict",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "warden.copyLocation",
          "when": "resourceScheme == warden-review",
          "group": "navigation"
        },
        {
          "command": "warden.sendSelectionToAgent",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Warden",
      "properties": {
        "warden.previewCommand": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "在预览目录运行的命令。也可直接使用 Warden 预览终端。"
        },
        "warden.acpAgents": {
          "type": "array",
          "default": [],
          "scope": "machine",
          "description": "ACP agents that read and write files and run their own commands. Profiles are read only from User or Remote User settings and launched with an executable and arguments. Warden does not provide agent filesystem or terminal tools.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$",
                "description": "Unique profile ID"
              },
              "label": {
                "type": "string",
                "description": "Display name"
              },
              "command": {
                "type": "string",
                "description": "Executable on the local or remote extension host; launched without an implicit shell"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Optional environment variables. Prefer the agent's own authentication setup instead of storing credentials in settings."
              }
            }
          }
        }
      }
    },
    "keybindings": [
      {
        "command": "warden.copyLocation",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && resourceScheme == warden-review"
      }
    ]
  }
}
