{
  "name": "warden",
  "displayName": "Warden Workspace Review",
  "description": "Plan parallel workspaces, review with native diffs, and run an isolated live preview.",
  "version": "0.21.3",
  "publisher": "xbghc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xbghc/warden.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Warden runs Git, commit hooks and explicitly configured setup scripts."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Warden needs a local or remote filesystem and Git."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "warden",
          "title": "Warden",
          "icon": "media/warden.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "warden-chat",
          "title": "Task Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "warden": [
        {
          "id": "warden.task",
          "name": "Workbench",
          "when": "workspaceFolderCount > 0",
          "initialSize": 2
        },
        {
          "id": "warden.settings",
          "name": "Settings",
          "when": "workspaceFolderCount > 0",
          "initialSize": 1,
          "visibility": "visible"
        }
      ],
      "warden-chat": [
        {
          "id": "warden.taskChat",
          "name": "Task Chat",
          "type": "webview",
          "when": "workspaceFolderCount > 0 && (warden.agentReady || warden.chatInSidebar)",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "commands": [
      {
        "command": "warden.selectRepository",
        "title": "Select Repository",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.refresh",
        "title": "Refresh",
        "category": "Warden",
        "icon": "$(refresh)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.configure",
        "title": "Select Base Branch",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.viewAsTree",
        "title": "View as Tree",
        "category": "Warden",
        "icon": "$(list-tree)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.viewAsList",
        "title": "View as List",
        "category": "Warden",
        "icon": "$(list-flat)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.createTask",
        "title": "New Task",
        "category": "Warden",
        "icon": "$(add)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.taskActions",
        "title": "Task Actions",
        "category": "Warden",
        "icon": "$(ellipsis)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.startTask",
        "title": "Retry Workspace Allocation",
        "category": "Warden",
        "icon": "$(refresh)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.editTask",
        "title": "Edit Task",
        "category": "Warden",
        "icon": "$(edit)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.moveTask",
        "title": "Reorder Tasks",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.connect",
        "title": "Connect / Disconnect Preview",
        "category": "Warden",
        "icon": "$(plug)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.openDiff",
        "title": "View Diff",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.deliver",
        "title": "Commit to Base Branch",
        "category": "Warden",
        "icon": "$(check)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.retryHook",
        "title": "Retry Workspace Setup",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.resumeTask",
        "title": "Finish Recovered Commit Preparation",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.previewTerminal",
        "title": "Open Preview Terminal",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.runPreview",
        "title": "Run Preview",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.previewPath",
        "title": "Copy Preview Path",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.refreshPreview",
        "title": "Sync Preview",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.setup",
        "title": "Rerun Preview Setup",
        "category": "Warden",
        "icon": "$(debug-restart)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.configureScripts",
        "title": "Settings",
        "category": "Warden"
      },
      {
        "command": "warden.rebase",
        "title": "Rebase",
        "category": "Warden",
        "icon": "$(sync)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.copyWorkspace",
        "title": "Copy Workspace Path",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.importNotes",
        "title": "Import Legacy Notes",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.selectTask",
        "title": "View Task Changes",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.showPreview",
        "title": "Show Preview Output",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.copyLocation",
        "title": "Copy Review Location",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.chat",
        "title": "Chat with Agent",
        "category": "Warden",
        "icon": "$(comment-discussion)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.configureAgents",
        "title": "Configure ACP",
        "category": "Warden"
      },
      {
        "command": "warden.chooseAgentPreset",
        "title": "Choose Agent Preset",
        "category": "Warden"
      },
      {
        "command": "warden.sendSelectionToAgent",
        "title": "Add Selection to Task Chat",
        "category": "Warden",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.openWorkspace",
        "title": "Open Workspace",
        "category": "Warden",
        "icon": "$(folder-opened)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.syncTask",
        "title": "Rebase Available",
        "category": "Warden",
        "icon": "$(sync)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.syncConflict",
        "title": "Rebase Conflicts Expected: View Details",
        "category": "Warden",
        "icon": "$(warning)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.moveTaskUp",
        "title": "Move Task Up",
        "category": "Warden",
        "icon": "$(arrow-up)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.moveTaskDown",
        "title": "Move Task Down",
        "category": "Warden",
        "icon": "$(arrow-down)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.taskHistory",
        "title": "Commits",
        "category": "Warden",
        "icon": "$(history)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.taskOutput",
        "title": "Show Setup Script Output",
        "category": "Warden",
        "icon": "$(output)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.copyBrief",
        "title": "Copy Task Notes",
        "category": "Warden",
        "icon": "$(copy)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.restoreTask",
        "title": "Restore Archived Task",
        "category": "Warden",
        "icon": "$(discard)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.recoverDelivery",
        "title": "Recover Commit Preparation",
        "category": "Warden",
        "icon": "$(debug-restart)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.recordDelivery",
        "title": "Record Reviewed Commit",
        "category": "Warden",
        "icon": "$(check)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.reviewTask",
        "title": "Review Current Changes",
        "category": "Warden",
        "icon": "$(diff)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.switchChat",
        "title": "Switch Task Chat",
        "category": "Warden",
        "icon": "$(list-selection)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.expandChat",
        "title": "Open Chat in Editor",
        "category": "Warden",
        "icon": "$(link-external)",
        "enablement": "warden.agentReady"
      },
      {
        "command": "warden.checkAgent",
        "title": "Connect ACP",
        "category": "Warden",
        "enablement": "warden.agentConfiguration == configured && warden.agentReadiness != checking"
      },
      {
        "command": "warden.cancelAgentCheck",
        "title": "Disconnect ACP",
        "category": "Warden",
        "enablement": "warden.agentReadiness == checking || warden.agentReadiness == authentication_required || warden.agentReadiness == ready"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "warden.refresh",
          "when": "warden.agentReady && (view == warden.task && warden.hasDevelopmentBranch)",
          "group": "navigation@1"
        },
        {
          "command": "warden.createTask",
          "when": "warden.agentReady && (view == warden.task && warden.hasDevelopmentBranch)",
          "group": "navigation@2"
        },
        {
          "command": "warden.viewAsTree",
          "when": "warden.agentReady && view == warden.task && warden.hasDevelopmentBranch && warden.fileViewMode == list",
          "group": "navigation@4"
        },
        {
          "command": "warden.viewAsList",
          "when": "warden.agentReady && view == warden.task && warden.hasDevelopmentBranch && warden.fileViewMode == tree",
          "group": "navigation@4"
        },
        {
          "command": "warden.selectRepository",
          "when": "warden.agentReady && (view == warden.task && (warden.repositoryState == unselected || (warden.repositoryState == ready && warden.multipleRoots)))",
          "group": "4_repository@1"
        },
        {
          "command": "warden.configureScripts",
          "when": "view == warden.task && warden.agentReady",
          "group": "5_settings@1"
        },
        {
          "command": "warden.rebase",
          "when": "warden.agentReady && (view == warden.task && warden.hasDevelopmentBranch)",
          "group": "navigation@3"
        },
        {
          "command": "warden.switchChat",
          "when": "warden.agentReady && (view == warden.taskChat)",
          "group": "navigation@1"
        },
        {
          "command": "warden.expandChat",
          "when": "warden.agentReady && (view == warden.taskChat && warden.chatInSidebar)",
          "group": "navigation@2"
        },
        {
          "command": "warden.refreshPreview",
          "when": "warden.agentReady && view == warden.task && warden.hasDevelopmentBranch && warden.previewNeedsSync",
          "group": "3_recovery@1"
        },
        {
          "command": "warden.runPreview",
          "when": "warden.agentReady && view == warden.task && warden.hasDevelopmentBranch && warden.hasPreviewCommand",
          "group": "2_preview@1"
        },
        {
          "command": "warden.previewTerminal",
          "when": "warden.agentReady && view == warden.task && warden.hasDevelopmentBranch && !warden.hasPreviewCommand",
          "group": "2_preview@1"
        },
        {
          "command": "warden.setup",
          "when": "warden.agentReady && view == warden.task && warden.hasDevelopmentBranch && warden.hasPreviewSetup && warden.previewSetupFailed",
          "group": "3_recovery@2"
        }
      ],
      "commandPalette": [
        {
          "command": "warden.chooseAgentPreset",
          "when": "false"
        },
        {
          "command": "warden.openDiff",
          "when": "false"
        },
        {
          "command": "warden.syncTask",
          "when": "false"
        },
        {
          "command": "warden.syncConflict",
          "when": "false"
        },
        {
          "command": "warden.moveTaskUp",
          "when": "false"
        },
        {
          "command": "warden.moveTaskDown",
          "when": "false"
        },
        {
          "command": "warden.taskOutput",
          "when": "false"
        },
        {
          "command": "warden.restoreTask",
          "when": "false"
        },
        {
          "command": "warden.recoverDelivery",
          "when": "false"
        },
        {
          "command": "warden.recordDelivery",
          "when": "false"
        },
        {
          "command": "warden.reviewTask",
          "when": "false"
        },
        {
          "command": "warden.startTask",
          "when": "false"
        },
        {
          "command": "warden.selectRepository",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.refresh",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.viewAsTree",
          "when": "warden.agentReady && warden.hasDevelopmentBranch && warden.fileViewMode == list"
        },
        {
          "command": "warden.viewAsList",
          "when": "warden.agentReady && warden.hasDevelopmentBranch && warden.fileViewMode == tree"
        },
        {
          "command": "warden.configure",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.createTask",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.taskActions",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.editTask",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.moveTask",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.connect",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.deliver",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.retryHook",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.resumeTask",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.previewTerminal",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.runPreview",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.previewPath",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.refreshPreview",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.setup",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.rebase",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.copyWorkspace",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.importNotes",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.selectTask",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.showPreview",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.copyLocation",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.chat",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.sendSelectionToAgent",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.openWorkspace",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.taskHistory",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.copyBrief",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.switchChat",
          "when": "warden.agentReady"
        },
        {
          "command": "warden.expandChat",
          "when": "warden.agentReady"
        }
      ],
      "editor/context": [
        {
          "command": "warden.copyLocation",
          "when": "resourceScheme == warden-review",
          "group": "navigation"
        },
        {
          "command": "warden.sendSelectionToAgent",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "warden.setup",
          "when": "warden.agentReady && view == warden.settings && viewItem == wardenPreviewSetup && warden.hasDevelopmentBranch && warden.hasPreviewSetup",
          "group": "inline@1"
        },
        {
          "command": "warden.startTask",
          "when": "view == warden.task && viewItem =~ /^wardenTask:plan:allocationFailed/",
          "group": "inline@1"
        },
        {
          "command": "warden.chat",
          "when": "view == warden.task && viewItem =~ /^wardenTask:(workspace|plan)/",
          "group": "inline@1"
        },
        {
          "command": "warden.connect",
          "when": "view == warden.task && viewItem =~ /^wardenTask:workspace/",
          "group": "inline@2"
        },
        {
          "command": "warden.deliver",
          "when": "view == warden.task && viewItem =~ /^wardenTask:workspace/ && !(viewItem =~ /prepareRecovery|recordDelivery/)",
          "group": "inline@3"
        },
        {
          "command": "warden.openWorkspace",
          "when": "view == warden.task && viewItem =~ /^wardenTask:(workspace|plan)/",
          "group": "1_workspace@1"
        },
        {
          "command": "warden.editTask",
          "when": "view == warden.task && viewItem =~ /^wardenTask:/",
          "group": "2_task@1"
        },
        {
          "command": "warden.moveTask",
          "when": "view == warden.task && viewItem =~ /^wardenTask:/",
          "group": "2_task@2"
        },
        {
          "command": "warden.restoreTask",
          "when": "view == warden.task && viewItem == wardenTask:archived",
          "group": "2_task@3"
        },
        {
          "command": "warden.taskHistory",
          "when": "view == warden.task && viewItem =~ /^wardenTask:workspace/",
          "group": "3_review@1"
        },
        {
          "command": "warden.rebase",
          "when": "view == warden.task && viewItem =~ /^wardenTask:workspace/",
          "group": "3_review@2"
        },
        {
          "command": "warden.resumeTask",
          "when": "view == warden.task && viewItem =~ /^wardenTask:.*recovery/",
          "group": "3_review@3"
        },
        {
          "command": "warden.taskOutput",
          "when": "view == warden.task && viewItem =~ /^wardenTask:.*hookFailed/",
          "group": "4_recovery@1"
        },
        {
          "command": "warden.retryHook",
          "when": "view == warden.task && viewItem =~ /^wardenTask:.*hookFailed/",
          "group": "4_recovery@2"
        },
        {
          "command": "warden.copyWorkspace",
          "when": "view == warden.task && viewItem =~ /^wardenTask:workspace/",
          "group": "5_copy@1"
        },
        {
          "command": "warden.copyBrief",
          "when": "view == warden.task && viewItem =~ /^wardenTask:/",
          "group": "5_copy@2"
        },
        {
          "command": "warden.recoverDelivery",
          "when": "view == warden.task && viewItem =~ /prepareRecovery/",
          "group": "inline@3"
        },
        {
          "command": "warden.recordDelivery",
          "when": "view == warden.task && viewItem =~ /recordDelivery/",
          "group": "inline@3"
        },
        {
          "command": "warden.reviewTask",
          "when": "view == warden.task && viewItem =~ /^wardenTask:workspace/",
          "group": "3_review@0"
        }
      ]
    },
    "configuration": {
      "title": "Warden",
      "properties": {
        "warden.previewCommand": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Command to run in the preview folder. You can also use the Warden preview terminal directly."
        },
        "warden.acpAgents": {
          "type": [
            "object",
            "array"
          ],
          "default": {},
          "scope": "machine",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$",
                "description": "Unique profile ID"
              },
              "label": {
                "type": "string",
                "description": "Display name"
              },
              "command": {
                "type": "string",
                "description": "Executable on the local or remote extension host; launched without an implicit shell"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Optional environment variables. Prefer the agent's own authentication setup instead of storing credentials in settings."
              }
            }
          },
          "markdownDescription": "Named ACP agents, using the object inside Zed or JetBrains `agent_servers`. Each entry supplies `command`, `args` and optional `env`; its name identifies saved conversations. Legacy profile arrays remain supported. Configure only in User or Remote User settings. Open **Warden: Configure ACP → Custom Agent Example** for a commented template. Agents must run their own file and command tools.",
          "maxProperties": 40,
          "maxItems": 40,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f]+$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "description": "Optional display name; defaults to the agent name. Changing the display name preserves conversation bindings."
              },
              "command": {
                "type": "string",
                "description": "Executable on the local or remote extension host; launched without an implicit shell"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Optional environment variables. Prefer the agent's own authentication setup instead of storing credentials in settings."
              },
              "type": {
                "type": "string",
                "enum": [
                  "custom"
                ],
                "description": "Optional compatibility field for Zed custom stdio agents."
              }
            }
          },
          "defaultSnippets": [
            {
              "label": "Custom ACP agent",
              "body": {
                "${1:my-agent}": {
                  "command": "${2:/absolute/path/to/acp-agent}",
                  "args": [],
                  "env": {}
                }
              }
            }
          ]
        }
      }
    },
    "keybindings": [
      {
        "command": "warden.copyLocation",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && resourceScheme == warden-review"
      },
      {
        "command": "warden.moveTaskUp",
        "key": "alt+up",
        "when": "focusedView == warden.task && listFocus && !inputFocus"
      },
      {
        "command": "warden.moveTaskDown",
        "key": "alt+down",
        "when": "focusedView == warden.task && listFocus && !inputFocus"
      }
    ],
    "viewsWelcome": [
      {
        "view": "warden.task",
        "contents": "[Configure ACP](command:warden.configureAgents)",
        "when": "warden.agentSetupRequired"
      },
      {
        "view": "warden.task",
        "contents": "Opening repository\u2026",
        "when": "warden.repositoryState != ready && warden.repositoryState != unselected"
      },
      {
        "view": "warden.task",
        "contents": "[Select Repository](command:warden.selectRepository)",
        "when": "warden.agentReady && (warden.repositoryState == unselected)"
      },
      {
        "view": "warden.task",
        "contents": "[Select Base Branch](command:warden.configure)",
        "when": "warden.agentReady && (warden.repositoryState == ready && !warden.hasDevelopmentBranch)"
      },
      {
        "view": "warden.task",
        "contents": "[New Task](command:warden.createTask)",
        "when": "warden.agentReady && warden.repositoryState == ready && warden.hasDevelopmentBranch"
      }
    ]
  }
}
