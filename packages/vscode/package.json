{
  "name": "warden",
  "displayName": "Warden Workspace Review",
  "description": "Plan parallel workspaces, review with native diffs, and run an isolated live preview.",
  "version": "0.20.4",
  "publisher": "xbghc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xbghc/warden.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Warden runs Git, commit hooks and explicitly configured setup scripts."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Warden needs a local or remote filesystem and Git."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "warden",
          "title": "Warden",
          "icon": "media/warden.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "warden-chat",
          "title": "Task Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "warden": [
        {
          "id": "warden.task",
          "name": "Workbench",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "warden-chat": [
        {
          "id": "warden.taskChat",
          "name": "Task Chat",
          "type": "webview",
          "when": "workspaceFolderCount > 0",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "commands": [
      {
        "command": "warden.selectRepository",
        "title": "Select Repository",
        "category": "Warden"
      },
      {
        "command": "warden.refresh",
        "title": "Refresh",
        "category": "Warden",
        "icon": "$(refresh)"
      },
      {
        "command": "warden.configure",
        "title": "Select Base Branch",
        "category": "Warden"
      },
      {
        "command": "warden.createTask",
        "title": "New Task",
        "category": "Warden",
        "icon": "$(add)"
      },
      {
        "command": "warden.taskActions",
        "title": "Task Actions",
        "category": "Warden",
        "icon": "$(ellipsis)"
      },
      {
        "command": "warden.startTask",
        "title": "Retry Workspace Allocation",
        "category": "Warden",
        "icon": "$(refresh)"
      },
      {
        "command": "warden.editTask",
        "title": "Edit Task",
        "category": "Warden",
        "icon": "$(edit)"
      },
      {
        "command": "warden.moveTask",
        "title": "Reorder Tasks",
        "category": "Warden"
      },
      {
        "command": "warden.connect",
        "title": "Connect / Disconnect Preview",
        "category": "Warden",
        "icon": "$(plug)"
      },
      {
        "command": "warden.openDiff",
        "title": "View Diff",
        "category": "Warden"
      },
      {
        "command": "warden.deliver",
        "title": "Commit to Base Branch",
        "category": "Warden",
        "icon": "$(check)"
      },
      {
        "command": "warden.retryHook",
        "title": "Retry Workspace Setup",
        "category": "Warden"
      },
      {
        "command": "warden.resumeTask",
        "title": "Finish Recovered Commit Preparation",
        "category": "Warden"
      },
      {
        "command": "warden.previewTerminal",
        "title": "Open Preview Terminal",
        "category": "Warden"
      },
      {
        "command": "warden.runPreview",
        "title": "Run Preview",
        "category": "Warden"
      },
      {
        "command": "warden.previewPath",
        "title": "Copy Preview Path",
        "category": "Warden"
      },
      {
        "command": "warden.refreshPreview",
        "title": "Sync Preview",
        "category": "Warden"
      },
      {
        "command": "warden.setup",
        "title": "Rerun Preview Setup",
        "category": "Warden"
      },
      {
        "command": "warden.configureScripts",
        "title": "Settings",
        "category": "Warden"
      },
      {
        "command": "warden.rebase",
        "title": "Rebase",
        "category": "Warden",
        "icon": "$(sync)"
      },
      {
        "command": "warden.copyWorkspace",
        "title": "Copy Workspace Path",
        "category": "Warden"
      },
      {
        "command": "warden.importNotes",
        "title": "Import Legacy Notes",
        "category": "Warden"
      },
      {
        "command": "warden.selectTask",
        "title": "View Task Changes",
        "category": "Warden"
      },
      {
        "command": "warden.showPreview",
        "title": "Show Preview",
        "category": "Warden"
      },
      {
        "command": "warden.copyLocation",
        "title": "Copy Review Location",
        "category": "Warden"
      },
      {
        "command": "warden.chat",
        "title": "Chat with Agent",
        "category": "Warden",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "warden.configureAgents",
        "title": "Configure ACP Agent",
        "category": "Warden"
      },
      {
        "command": "warden.sendSelectionToAgent",
        "title": "Add Selection to Task Chat",
        "category": "Warden"
      },
      {
        "command": "warden.openWorkspace",
        "title": "Open Workspace",
        "category": "Warden",
        "icon": "$(folder-opened)"
      },
      {
        "command": "warden.syncTask",
        "title": "Rebase Available",
        "category": "Warden",
        "icon": "$(sync)"
      },
      {
        "command": "warden.syncConflict",
        "title": "Rebase Conflicts Expected: View Details",
        "category": "Warden",
        "icon": "$(warning)"
      },
      {
        "command": "warden.moveTaskUp",
        "title": "Move Task Up",
        "category": "Warden",
        "icon": "$(arrow-up)"
      },
      {
        "command": "warden.moveTaskDown",
        "title": "Move Task Down",
        "category": "Warden",
        "icon": "$(arrow-down)"
      },
      {
        "command": "warden.taskHistory",
        "title": "Commits",
        "category": "Warden",
        "icon": "$(history)"
      },
      {
        "command": "warden.taskOutput",
        "title": "Show Setup Script Output",
        "category": "Warden",
        "icon": "$(output)"
      },
      {
        "command": "warden.copyBrief",
        "title": "Copy Task Notes",
        "category": "Warden",
        "icon": "$(copy)"
      },
      {
        "command": "warden.restoreTask",
        "title": "Restore Archived Task",
        "category": "Warden",
        "icon": "$(discard)"
      },
      {
        "command": "warden.recoverDelivery",
        "title": "Recover Commit Preparation",
        "category": "Warden",
        "icon": "$(debug-restart)"
      },
      {
        "command": "warden.recordDelivery",
        "title": "Record Reviewed Commit",
        "category": "Warden",
        "icon": "$(check)"
      },
      {
        "command": "warden.reviewTask",
        "title": "Review Current Changes",
        "category": "Warden",
        "icon": "$(diff)"
      },
      {
        "command": "warden.switchChat",
        "title": "Switch Task Chat",
        "category": "Warden",
        "icon": "$(list-selection)"
      },
      {
        "command": "warden.expandChat",
        "title": "Open Chat in Editor",
        "category": "Warden",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "warden.refresh",
          "when": "view == warden.task && warden.hasDevelopmentBranch",
          "group": "navigation@1"
        },
        {
          "command": "warden.createTask",
          "when": "view == warden.task && warden.hasDevelopmentBranch",
          "group": "navigation@2"
        },
        {
          "command": "warden.configure",
          "when": "view == warden.task && warden.hasDevelopmentBranch"
        },
        {
          "command": "warden.selectRepository",
          "when": "view == warden.task && (warden.repositoryState == unselected || (warden.repositoryState == ready && warden.multipleRoots))"
        },
        {
          "command": "warden.configureScripts",
          "when": "view == warden.task && warden.hasDevelopmentBranch"
        },
        {
          "command": "warden.rebase",
          "when": "view == warden.task && warden.hasDevelopmentBranch",
          "group": "navigation@3"
        },
        {
          "command": "warden.switchChat",
          "when": "view == warden.taskChat",
          "group": "navigation@1"
        },
        {
          "command": "warden.expandChat",
          "when": "view == warden.taskChat && warden.chatInSidebar",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "warden.openDiff",
          "when": "false"
        },
        {
          "command": "warden.syncTask",
          "when": "false"
        },
        {
          "command": "warden.syncConflict",
          "when": "false"
        },
        {
          "command": "warden.moveTaskUp",
          "when": "false"
        },
        {
          "command": "warden.moveTaskDown",
          "when": "false"
        },
        {
          "command": "warden.taskOutput",
          "when": "false"
        },
        {
          "command": "warden.restoreTask",
          "when": "false"
        },
        {
          "command": "warden.recoverDelivery",
          "when": "false"
        },
        {
          "command": "warden.recordDelivery",
          "when": "false"
        },
        {
          "command": "warden.reviewTask",
          "when": "false"
        },
        {
          "command": "warden.startTask",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "warden.copyLocation",
          "when": "resourceScheme == warden-review",
          "group": "navigation"
        },
        {
          "command": "warden.sendSelectionToAgent",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "warden.startTask",
          "when": "view == warden.task && viewItem =~ /^wardenTask:plan:allocationFailed/",
          "group": "inline@1"
        },
        {
          "command": "warden.chat",
          "when": "view == warden.task && viewItem =~ /^wardenTask:(workspace|plan)/",
          "group": "inline@1"
        },
        {
          "command": "warden.connect",
          "when": "view == warden.task && viewItem =~ /^wardenTask:workspace/",
          "group": "inline@2"
        },
        {
          "command": "warden.deliver",
          "when": "view == warden.task && viewItem =~ /^wardenTask:workspace/ && !(viewItem =~ /prepareRecovery|recordDelivery/)",
          "group": "inline@3"
        },
        {
          "command": "warden.openWorkspace",
          "when": "view == warden.task && viewItem =~ /^wardenTask:(workspace|plan)/",
          "group": "1_workspace@1"
        },
        {
          "command": "warden.editTask",
          "when": "view == warden.task && viewItem =~ /^wardenTask:/",
          "group": "2_task@1"
        },
        {
          "command": "warden.moveTask",
          "when": "view == warden.task && viewItem =~ /^wardenTask:/",
          "group": "2_task@2"
        },
        {
          "command": "warden.restoreTask",
          "when": "view == warden.task && viewItem == wardenTask:archived",
          "group": "2_task@3"
        },
        {
          "command": "warden.taskHistory",
          "when": "view == warden.task && viewItem =~ /^wardenTask:workspace/",
          "group": "3_review@1"
        },
        {
          "command": "warden.rebase",
          "when": "view == warden.task && viewItem =~ /^wardenTask:workspace/",
          "group": "3_review@2"
        },
        {
          "command": "warden.resumeTask",
          "when": "view == warden.task && viewItem =~ /^wardenTask:.*recovery/",
          "group": "3_review@3"
        },
        {
          "command": "warden.taskOutput",
          "when": "view == warden.task && viewItem =~ /^wardenTask:.*hookFailed/",
          "group": "4_recovery@1"
        },
        {
          "command": "warden.retryHook",
          "when": "view == warden.task && viewItem =~ /^wardenTask:.*hookFailed/",
          "group": "4_recovery@2"
        },
        {
          "command": "warden.copyWorkspace",
          "when": "view == warden.task && viewItem =~ /^wardenTask:workspace/",
          "group": "5_copy@1"
        },
        {
          "command": "warden.copyBrief",
          "when": "view == warden.task && viewItem =~ /^wardenTask:/",
          "group": "5_copy@2"
        },
        {
          "command": "warden.refreshPreview",
          "when": "view == warden.task && viewItem == preview",
          "group": "inline@1"
        },
        {
          "command": "warden.previewTerminal",
          "when": "view == warden.task && viewItem == preview",
          "group": "inline@2"
        },
        {
          "command": "warden.createTask",
          "when": "view == warden.task && viewItem == tasks",
          "group": "inline@1"
        },
        {
          "command": "warden.recoverDelivery",
          "when": "view == warden.task && viewItem =~ /prepareRecovery/",
          "group": "inline@3"
        },
        {
          "command": "warden.recordDelivery",
          "when": "view == warden.task && viewItem =~ /recordDelivery/",
          "group": "inline@3"
        },
        {
          "command": "warden.reviewTask",
          "when": "view == warden.task && viewItem =~ /^wardenTask:workspace/",
          "group": "3_review@0"
        }
      ]
    },
    "configuration": {
      "title": "Warden",
      "properties": {
        "warden.previewCommand": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Command to run in the preview folder. You can also use the Warden preview terminal directly."
        },
        "warden.acpAgents": {
          "type": "array",
          "default": [],
          "scope": "machine",
          "description": "ACP agents that read and write files and run their own commands. Profiles are read only from User or Remote User settings and launched with an executable and arguments. Warden does not provide agent filesystem or terminal tools.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$",
                "description": "Unique profile ID"
              },
              "label": {
                "type": "string",
                "description": "Display name"
              },
              "command": {
                "type": "string",
                "description": "Executable on the local or remote extension host; launched without an implicit shell"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Optional environment variables. Prefer the agent's own authentication setup instead of storing credentials in settings."
              }
            }
          }
        }
      }
    },
    "keybindings": [
      {
        "command": "warden.copyLocation",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && resourceScheme == warden-review"
      },
      {
        "command": "warden.moveTaskUp",
        "key": "alt+up",
        "when": "focusedView == warden.task && listFocus && !inputFocus"
      },
      {
        "command": "warden.moveTaskDown",
        "key": "alt+down",
        "when": "focusedView == warden.task && listFocus && !inputFocus"
      }
    ],
    "viewsWelcome": [
      {
        "view": "warden.task",
        "contents": "Opening repository\u2026",
        "when": "warden.repositoryState != ready && warden.repositoryState != unselected"
      },
      {
        "view": "warden.task",
        "contents": "[Select Repository](command:warden.selectRepository)",
        "when": "warden.repositoryState == unselected"
      },
      {
        "view": "warden.task",
        "contents": "[Select Base Branch](command:warden.configure)",
        "when": "warden.repositoryState == ready && !warden.hasDevelopmentBranch"
      }
    ]
  }
}
