{
  "name": "warden",
  "displayName": "Warden Workspace Review",
  "description": "Plan parallel workspaces, review with native diffs, and run an isolated live preview.",
  "version": "0.19.1",
  "publisher": "xbghc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xbghc/warden.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Warden runs Git, commit hooks and explicitly configured setup scripts."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Warden needs a local or remote filesystem and Git."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "warden",
          "title": "Warden",
          "icon": "media/warden.svg"
        }
      ]
    },
    "views": {
      "warden": [
        {
          "id": "warden.workbench",
          "name": "工作区"
        },
        {
          "id": "warden.task",
          "name": "当前任务",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "warden.selectRepository",
        "title": "选择仓库",
        "category": "Warden"
      },
      {
        "command": "warden.refresh",
        "title": "刷新",
        "category": "Warden",
        "icon": "$(refresh)"
      },
      {
        "command": "warden.configure",
        "title": "选择主开发分支",
        "category": "Warden"
      },
      {
        "command": "warden.createTask",
        "title": "新增任务",
        "category": "Warden",
        "icon": "$(add)"
      },
      {
        "command": "warden.taskActions",
        "title": "任务操作",
        "category": "Warden"
      },
      {
        "command": "warden.startTask",
        "title": "创建工作区",
        "category": "Warden",
        "icon": "$(add)"
      },
      {
        "command": "warden.editTask",
        "title": "编辑任务",
        "category": "Warden"
      },
      {
        "command": "warden.moveTask",
        "title": "调整计划顺序",
        "category": "Warden"
      },
      {
        "command": "warden.connect",
        "title": "连接／断开预览",
        "category": "Warden",
        "icon": "$(plug)"
      },
      {
        "command": "warden.openDiff",
        "title": "打开原生差异",
        "category": "Warden"
      },
      {
        "command": "warden.deliver",
        "title": "交付提交",
        "category": "Warden"
      },
      {
        "command": "warden.retryHook",
        "title": "重试工作区脚本",
        "category": "Warden"
      },
      {
        "command": "warden.resumeTask",
        "title": "结束已恢复的提交准备",
        "category": "Warden"
      },
      {
        "command": "warden.previewTerminal",
        "title": "打开预览终端",
        "category": "Warden"
      },
      {
        "command": "warden.runPreview",
        "title": "运行预览",
        "category": "Warden"
      },
      {
        "command": "warden.previewPath",
        "title": "复制预览路径",
        "category": "Warden"
      },
      {
        "command": "warden.refreshPreview",
        "title": "立即同步预览",
        "category": "Warden"
      },
      {
        "command": "warden.setup",
        "title": "重跑预览 setup",
        "category": "Warden"
      },
      {
        "command": "warden.configureScripts",
        "title": "编辑脚本配置",
        "category": "Warden"
      },
      {
        "command": "warden.rebase",
        "title": "同步工作区",
        "category": "Warden"
      },
      {
        "command": "warden.editHistory",
        "title": "编辑提交历史",
        "category": "Warden"
      },
      {
        "command": "warden.taskDetails",
        "title": "查看任务说明",
        "category": "Warden"
      },
      {
        "command": "warden.copyWorkspace",
        "title": "复制工作区路径",
        "category": "Warden"
      },
      {
        "command": "warden.importNotes",
        "title": "导入旧笔记",
        "category": "Warden"
      },
      {
        "command": "warden.selectTask",
        "title": "查看任务变更",
        "category": "Warden"
      },
      {
        "command": "warden.showPreview",
        "title": "查看预览",
        "category": "Warden"
      },
      {
        "command": "warden.copyLocation",
        "title": "复制审阅位置",
        "category": "Warden"
      },
      {
        "command": "warden.chat",
        "title": "与 Agent 对话",
        "category": "Warden"
      },
      {
        "command": "warden.configureAgents",
        "title": "配置 ACP Agent",
        "category": "Warden"
      },
      {
        "command": "warden.sendSelectionToAgent",
        "title": "发送选区到任务对话",
        "category": "Warden"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "warden.refresh",
          "when": "view == warden.workbench",
          "group": "navigation@1"
        },
        {
          "command": "warden.createTask",
          "when": "view == warden.workbench",
          "group": "navigation@2"
        },
        {
          "command": "warden.configure",
          "when": "view == warden.workbench"
        },
        {
          "command": "warden.selectRepository",
          "when": "view == warden.workbench"
        },
        {
          "command": "warden.configureScripts",
          "when": "view == warden.workbench"
        },
        {
          "command": "warden.rebase",
          "when": "view == warden.workbench"
        },
        {
          "command": "warden.editHistory",
          "when": "view == warden.workbench"
        }
      ],
      "view/item/context": [
        {
          "command": "warden.chat",
          "when": "view == warden.workbench && viewItem =~ /^task/",
          "group": "navigation@1"
        },
        {
          "command": "warden.connect",
          "when": "view == warden.workbench && viewItem =~ /^task/",
          "group": "inline@1"
        },
        {
          "command": "warden.deliver",
          "when": "view == warden.workbench && viewItem =~ /^task/"
        },
        {
          "command": "warden.taskDetails",
          "when": "view == warden.workbench && viewItem =~ /^task/"
        },
        {
          "command": "warden.copyWorkspace",
          "when": "view == warden.workbench && viewItem =~ /^task/"
        },
        {
          "command": "warden.retryHook",
          "when": "view == warden.workbench && viewItem =~ /^task/"
        },
        {
          "command": "warden.resumeTask",
          "when": "view == warden.workbench && viewItem =~ /^task/"
        },
        {
          "command": "warden.editTask",
          "when": "view == warden.workbench && viewItem =~ /^task/"
        },
        {
          "command": "warden.moveTask",
          "when": "view == warden.workbench && viewItem =~ /^task/"
        },
        {
          "command": "warden.startTask",
          "when": "view == warden.workbench && viewItem == plan"
        },
        {
          "command": "warden.editTask",
          "when": "view == warden.workbench && viewItem == plan"
        },
        {
          "command": "warden.moveTask",
          "when": "view == warden.workbench && viewItem == plan"
        },
        {
          "command": "warden.previewTerminal",
          "when": "view == warden.workbench && viewItem == preview"
        },
        {
          "command": "warden.runPreview",
          "when": "view == warden.workbench && viewItem == preview"
        },
        {
          "command": "warden.refreshPreview",
          "when": "view == warden.workbench && viewItem == preview"
        },
        {
          "command": "warden.setup",
          "when": "view == warden.workbench && viewItem == preview"
        },
        {
          "command": "warden.previewPath",
          "when": "view == warden.workbench && viewItem == preview"
        },
        {
          "command": "warden.editHistory",
          "when": "view == warden.workbench && viewItem == history"
        }
      ],
      "commandPalette": [
        {
          "command": "warden.openDiff",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "warden.copyLocation",
          "when": "resourceScheme == warden-review",
          "group": "navigation"
        },
        {
          "command": "warden.sendSelectionToAgent",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Warden",
      "properties": {
        "warden.previewCommand": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "在预览目录运行的命令。也可直接使用 Warden 预览终端。"
        },
        "warden.acpAgents": {
          "type": "array",
          "default": [],
          "scope": "machine",
          "description": "能自行读写文件和执行命令的 ACP Agent。仅从用户或远程用户设置读取，按可执行文件和参数启动；Warden 不提供文件和终端工具。",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$",
                "description": "唯一配置标识"
              },
              "label": {
                "type": "string",
                "description": "显示名称"
              },
              "command": {
                "type": "string",
                "description": "本地或远程扩展宿主中的可执行文件，不经过隐式 shell"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "可选环境变量；优先使用 Agent 自己的登录配置，避免在设置中保存凭据"
              }
            }
          }
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "warden.workbench",
        "contents": "打开主目录开始编程。\n[选择仓库](command:warden.selectRepository)\n[选择主开发分支](command:warden.configure)"
      }
    ],
    "keybindings": [
      {
        "command": "warden.copyLocation",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && resourceScheme == warden-review"
      }
    ]
  }
}
