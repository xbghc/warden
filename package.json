{
  "name": "warden-workspace",
  "description": "VS Code workspace development and review workbench",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xbghc/warden.git"
  },
  "keywords": [
    "git",
    "diff",
    "review",
    "code-review",
    "agent",
    "wsl"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "storybook": "pnpm --filter @warden/webview storybook",
    "build:storybook": "pnpm --filter @warden/webview build:storybook",
    "build": "pnpm build:native && pnpm build:vscode",
    "build:native": "node scripts/native-build.mjs",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @warden/webview typecheck && tsc --noEmit -p packages/vscode/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:release": "node scripts/check-release.mjs",
    "check:vscode": "node scripts/check-vscode-package.mjs",
    "bench:git": "node --import tsx scripts/bench-git.mjs",
    "build:vscode": "node scripts/check-release.mjs && node scripts/build-vscode.mjs && pnpm build:webview",
    "package:vscode": "pnpm build:vscode && cd packages/vscode && vsce package --no-dependencies",
    "test:vscode": "node --import tsx scripts/test-vscode.mjs",
    "build:webview": "pnpm --filter @warden/webview build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^22.20.1",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.0.0",
    "@warden/shared": "workspace:*",
    "fflate": "0.8.2",
    "hono": "^4.13.7",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@warden/engine": "workspace:*"
  },
  "private": true
}
